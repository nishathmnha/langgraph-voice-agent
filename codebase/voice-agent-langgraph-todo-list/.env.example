OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: leave blank to let the model auto-detect language.
OPENAI_TRANSCRIPTION_LANGUAGE=
# Optional: add domain vocabulary if you have recurring product or team-specific terms.
OPENAI_TRANSCRIPTION_PROMPT=Transcribe the speaker exactly. Preserve technical terms, product names, file names, numbers, and short task phrases when clear. Do not invent words that were not spoken.
