flowchart TD
    Start([Start])
    Setup{"Registered?"}
    Register["Enter username and API key"]
    Tenant["Generate tenant_id"]
    Main["Open main UI"]
    Choice{"Input method"}
    Text["Type command"]
    Voice["Record audio"]
    STT["Convert speech to text"]
    Agent["Run LangGraph workflow"]
    DB["Update PostgreSQL using tenant_id"]
    UI["Show response and refreshed tasks"]
    End([End])

    Start --> Setup
    Setup -->|"no"| Register --> Tenant --> Main
    Setup -->|"yes"| Main
    Main --> Choice
    Choice -->|"text"| Text --> Agent
    Choice -->|"voice"| Voice --> STT --> Agent
    Agent --> DB --> UI --> End
