classDiagram
    class User {
        uuid id
        string tenant_id
        string username
        string api_key
        datetime created_at
    }

    class Task {
        uuid id
        string tenant_id
        string task_title
        string task_description
        string status
        string priority
        datetime created_at
        datetime updated_at
        datetime completed_at
    }

    class TaskLog {
        uuid id
        string tenant_id
        uuid task_id
        string action
        datetime timestamp
    }

    class AgentState {
        string tenant_id
        string raw_input
        string transcript
        string intent
        dict entities
        string matched_task_id
        dict tool_result
        string response
    }

    class TaskService {
        create_task()
        update_task()
        complete_task()
        delete_task()
        query_tasks()
    }

    class SpeechToTextService {
        transcribe_audio()
    }

    User "1" --> "*" Task : tenant_id
    Task "1" --> "*" TaskLog : task_id
    AgentState --> TaskService
    TaskService --> Task
    TaskService --> TaskLog
    SpeechToTextService --> AgentState
