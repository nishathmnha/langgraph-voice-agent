flowchart TD
    Start([START])
    Normalize["normalize_input<br/>clean text and dates"]
    Intent["detect_intent"]
    Extract["extract_entities"]
    Match["match_task<br/>when existing task is referenced"]
    Clarify{"Need clarification?"}
    Decide["decide_action"]
    Create["create_task"]
    Update["update_task"]
    Complete["complete_task"]
    Delete["delete_task"]
    Prioritize["prioritize_task"]
    Query["query_tasks"]
    Log["log_task_action"]
    Respond["generate_response"]
    End([END])

    Start --> Normalize --> Intent --> Extract --> Match --> Clarify
    Clarify -->|"yes"| Respond
    Clarify -->|"no"| Decide
    Decide -->|"create"| Create
    Decide -->|"update"| Update
    Decide -->|"complete"| Complete
    Decide -->|"delete"| Delete
    Decide -->|"prioritize"| Prioritize
    Decide -->|"query"| Query
    Create --> Log
    Update --> Log
    Complete --> Log
    Delete --> Log
    Prioritize --> Log
    Query --> Log
    Log --> Respond
    Respond --> End
