flowchart TD
    Start([START])
    Normalize["Normalize input<br/>clean transcript and resolve relative dates"]
    Intent["Classify intent"]
    Add["Add todo node"]
    List["List todo node"]
    Update["Update todo node"]
    Delete["Delete todo node"]
    Progress["Progress update node"]
    Match["Match spoken items<br/>to existing tasks"]
    Clarify{"Need clarification?"}
    Execute["Execute tool"]
    Log["Create or update time log"]
    Respond["Generate response"]
    End([END])

    Start --> Normalize --> Intent
    Intent -->|"add_todo"| Add
    Intent -->|"list_todo"| List
    Intent -->|"update_todo"| Update
    Intent -->|"delete_todo"| Delete
    Intent -->|"progress_update"| Progress
    Add --> Clarify
    Update --> Clarify
    Delete --> Clarify
    Progress --> Match --> Clarify
    List --> Execute
    Clarify -->|"yes"| Respond
    Clarify -->|"no"| Execute
    Execute --> Log
    Execute --> Respond
    Log --> Respond
    Respond --> End
