flowchart TD
    Audio["Audio input"]
    STT["Speech-to-text"]
    Graph["Single LangGraph agent"]
    Intent["classify_intent"]
    Route{"route_intent"}

    Add["add_todo node"]
    Update["update_todo node"]
    Complete["complete_todo node"]
    List["list_todos node"]
    Clarify["clarify node"]

    MatchTool["find_matching_todo tool"]
    CreateTool["create_todo tool"]
    UpdateTool["update_todo tool"]
    CompleteTool["complete_todo tool"]
    ListTool["list_todos tool"]

    DB[("Todo database")]
    Response["Text/UI response"]

    Audio --> STT --> Graph --> Intent --> Route

    Route -->|"new task"| Add
    Route -->|"change priority/details"| Update
    Route -->|"task completed"| Complete
    Route -->|"what is left?"| List
    Route -->|"unclear"| Clarify

    Add --> CreateTool --> DB
    Update --> MatchTool --> UpdateTool --> DB
    Complete --> MatchTool --> CompleteTool --> DB
    List --> ListTool --> DB
    Clarify --> Response

    DB --> Response

