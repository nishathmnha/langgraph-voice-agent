erDiagram
    USERS ||--o{ TASKS : owns
    USERS ||--o{ TIME_LOGS : owns
    USERS ||--o{ AGENT_SESSIONS : starts
    TASKS ||--o{ TIME_LOGS : generates
    TASKS ||--o{ TASK_MATCH_EVENTS : matched_by
    AGENT_SESSIONS ||--o{ TASK_MATCH_EVENTS : records

    USERS {
        int id PK
        string display_name
        string timezone
        datetime created_at
    }

    TASKS {
        int id PK
        int user_id FK
        string title
        string description
        string status
        string priority
        date due_date
        time due_time
        string source
        datetime created_at
        datetime updated_at
        datetime completed_at
        datetime archived_at
    }

    TIME_LOGS {
        int id PK
        int task_id FK
        int user_id FK
        date work_date
        datetime start_time
        datetime end_time
        int duration_minutes
        string note
        datetime created_at
        datetime updated_at
    }

    AGENT_SESSIONS {
        string id PK
        int user_id FK
        string channel
        datetime started_at
        datetime ended_at
        string last_intent
        string pending_clarification_json
    }

    TASK_MATCH_EVENTS {
        int id PK
        int task_id FK
        string session_id FK
        string spoken_text
        float match_score
        string decision
        datetime created_at
    }

